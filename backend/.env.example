# Backend configuration (copy to .env for real services)
NODE_ENV=development
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=aquafound

# Email (Zoho SMTP)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=you@example.com
EMAIL_PASS=your_password
EMAIL_TO=Sambo198787@icloud.com

# CORS allowlist
CORS_ALLOW=http://localhost:5173,http://127.0.0.1:5173

# Timezone
BUSINESS_TZ=America/New_York

# Dev-only mocks
# USE_MOCK_DB=true
# USE_MOCK_EMAIL=true
